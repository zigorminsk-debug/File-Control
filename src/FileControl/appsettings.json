{
  "Urls": "http://127.0.0.1:8787",
  "FileControl": {
    "MonitoredPaths": [],
    "DatabasePath": "data\\filecontrol.db",
    "ReportDirectory": "reports",
    "ReportHour": 1,
    "RetentionDays": 365,
    "OfficeCorrelationSeconds": 15,
    "IgnoredUsers": [ "SYSTEM", "LOCAL SERVICE", "NETWORK SERVICE" ],
    "EmailAlerts": {
      "Enabled": false,
      "Threshold": 10,
      "WindowMinutes": 2,
      "CooldownMinutes": 30,
      "SmtpHost": "",
      "SmtpPort": 587,
      "UseSsl": true,
      "Username": "",
      "Password": "",
      "From": "",
      "Recipients": []
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
